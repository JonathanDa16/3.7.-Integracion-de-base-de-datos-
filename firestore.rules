rules_version = '2';

// Reglas de Cloud Firestore para CineCatálogo (actividad 3.7).
//
// El modelo guarda todo en subcolecciones del documento del usuario:
//
//   usuarios/{uid}/favoritos/{peliculaId}
//   usuarios/{uid}/calificaciones/{peliculaId}
//
// En Firestore las reglas NO se heredan de un documento a sus subcolecciones,
// así que cada nivel se declara aparte. La condición `request.auth.uid == uid`
// hace que cada dispositivo anónimo solo pueda leer y escribir su propia lista,
// aunque conozca el identificador de otra persona.
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /favoritos/{peliculaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /calificaciones/{peliculaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Cualquier otra ruta queda cerrada.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
